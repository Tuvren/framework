{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schemas/conformance-plan.schema.json",
  "type": "object",
  "required": ["planId", "planVersion", "packetId", "applicability", "checks"],
  "additionalProperties": false,
  "$defs": {
    "contextPath": { "type": "string", "pattern": "^\\$(\\..+)?$" },
    "claimIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "argumentReference": {
      "type": "object",
      "required": ["$ref"],
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^(?:input|fixture\\.input|capture)(?:\\.[^.]+)+$"
        }
      }
    },
    "argumentLiteral": {
      "type": "object",
      "required": ["$literal"],
      "additionalProperties": false,
      "properties": { "$literal": {} }
    },
    "argumentValue": {
      "if": { "type": "object", "required": ["$ref"] },
      "then": { "$ref": "#/$defs/argumentReference" },
      "else": {
        "if": { "type": "object", "required": ["$literal"] },
        "then": { "$ref": "#/$defs/argumentLiteral" },
        "else": {
          "items": { "$ref": "#/$defs/argumentValue" },
          "additionalProperties": { "$ref": "#/$defs/argumentValue" }
        }
      }
    },
    "capture": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[^.]+$" },
        "path": {
          "type": "string",
          "pattern": "^(?:result|events|state)(?:\\.[^.]+)*$"
        }
      }
    },
    "stepControls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadlineMs": { "type": "integer", "minimum": 1 },
        "cancelAfterEvent": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "required": ["stepId", "operation"],
      "additionalProperties": false,
      "properties": {
        "stepId": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "action": {
          "type": "string",
          "enum": [
            "dispatch",
            "start",
            "await",
            "cancel",
            "subscribe",
            "pull",
            "barrier",
            "release",
            "restart",
            "kill",
            "respawn",
            "openInstance",
            "armFault",
            "setClock"
          ],
          "default": "dispatch"
        },
        "claimIds": { "$ref": "#/$defs/claimIds" },
        "input": {},
        "arguments": { "type": "object", "$ref": "#/$defs/argumentValue" },
        "capture": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capture" }
        },
        "inspectState": {},
        "controls": { "$ref": "#/$defs/stepControls" },
        "barrierId": { "type": "string", "minLength": 1 },
        "seam": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" },
          "default": []
        }
      },
      "dependentSchemas": {
        "arguments": { "not": { "required": ["input"] } }
      },
      "allOf": [
        {
          "if": {
            "required": ["action"],
            "properties": { "action": { "const": "barrier" } }
          },
          "then": { "required": ["barrierId", "seam", "participants"] }
        },
        {
          "if": {
            "required": ["action"],
            "properties": { "action": { "const": "release" } }
          },
          "then": { "required": ["barrierId"], "not": { "required": ["seam"] } }
        },
        {
          "if": {
            "not": {
              "required": ["action"],
              "properties": { "action": { "enum": ["barrier", "release"] } }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["barrierId"] },
                { "required": ["seam"] },
                { "required": ["participants"] }
              ]
            }
          }
        }
      ]
    },
    "numericOperand": {
      "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/contextPath" }]
    },
    "lengthOperand": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "$ref": "#/$defs/contextPath" }
      ]
    },
    "when": {
      "type": "object",
      "required": ["path", "equals"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/contextPath" },
        "equals": {}
      }
    },
    "valueOperators": {
      "type": "object",
      "properties": {
        "equals": {},
        "equalsPath": { "type": "string", "minLength": 1 },
        "notEquals": {},
        "notEqualsPath": { "$ref": "#/$defs/contextPath" },
        "matches": { "type": "string", "minLength": 1 },
        "contains": {},
        "containsPath": { "type": "string", "minLength": 1 },
        "lessThan": { "$ref": "#/$defs/numericOperand" },
        "lessThanOrEqual": { "$ref": "#/$defs/numericOperand" },
        "greaterThan": { "$ref": "#/$defs/numericOperand" },
        "greaterThanOrEqual": { "$ref": "#/$defs/numericOperand" },
        "length": { "$ref": "#/$defs/lengthOperand" },
        "every": { "$ref": "#/$defs/elementAssertion" },
        "some": { "$ref": "#/$defs/elementAssertion" },
        "present": { "type": "boolean" }
      },
      "dependentRequired": { "every": ["length"], "some": ["length"] }
    },
    "elementAssertion": {
      "$ref": "#/$defs/valueOperators",
      "type": "object",
      "properties": {
        "field": { "type": "string", "minLength": 1 }
      },
      "unevaluatedProperties": false
    },
    "integrityReference": {
      "type": "object",
      "required": ["path", "targetPath", "recordType"],
      "additionalProperties": false,
      "properties": {
        "nullable": { "type": "boolean" },
        "path": {
          "$ref": "#/$defs/contextPath"
        },
        "targetPath": {
          "$ref": "#/$defs/contextPath"
        },
        "recordType": {
          "enum": ["opaque-object", "turn-node", "turn-tree", "schema"]
        },
        "hashPath": {
          "$ref": "#/$defs/contextPath"
        },
        "valuePath": {
          "$ref": "#/$defs/contextPath"
        },
        "length": {
          "$ref": "#/$defs/lengthOperand"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "path": {
                "pattern": "\\.\\*"
              }
            }
          },
          "then": {
            "required": ["length"]
          }
        }
      ]
    },
    "assertion": {
      "$ref": "#/$defs/valueOperators",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "eventSequence",
            "terminalEvent",
            "schemaValid",
            "errorEnvelope",
            "resultField",
            "stateField",
            "evidenceField",
            "ordering",
            "noEvent",
            "secretAbsence",
            "secretPatternAbsence",
            "digest",
            "canonicalCbor",
            "identity",
            "referenceWalk",
            "faultActivated",
            "arrival"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "secretsPath": { "type": "string", "minLength": 1 },
        "eventType": { "type": "string", "minLength": 1 },
        "recordType": {
          "enum": ["opaque-object", "turn-node", "turn-tree", "schema"]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/integrityReference"
          }
        },
        "when": { "$ref": "#/$defs/when" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "faultActivated" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["path"],
            "properties": {
              "path": { "pattern": "^\\$\\.capture\\.[^.]+(?:\\.[^.]+)*$" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "resultField" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["field"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "noEvent" }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "required": ["field"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "secretAbsence" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["field", "secretsPath"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "secretPatternAbsence" }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["field"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["digest", "canonicalCbor", "identity"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["path", "equalsPath"],
            "properties": {
              "path": {
                "$ref": "#/$defs/contextPath"
              },
              "equalsPath": {
                "$ref": "#/$defs/contextPath"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["canonicalCbor", "identity"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["recordType"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "referenceWalk"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["path", "references"],
            "properties": {
              "path": {
                "$ref": "#/$defs/contextPath"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["digest", "canonicalCbor", "identity", "referenceWalk"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["equals"]
                },
                {
                  "required": ["notEquals"]
                },
                {
                  "required": ["notEqualsPath"]
                },
                {
                  "required": ["contains"]
                },
                {
                  "required": ["containsPath"]
                },
                {
                  "required": ["matches"]
                },
                {
                  "required": ["every"]
                },
                {
                  "required": ["some"]
                },
                {
                  "required": ["length"]
                },
                {
                  "required": ["present"]
                },
                {
                  "required": ["greaterThan"]
                },
                {
                  "required": ["greaterThanOrEqual"]
                },
                {
                  "required": ["lessThan"]
                },
                {
                  "required": ["lessThanOrEqual"]
                },
                {
                  "required": ["field"]
                },
                {
                  "required": ["schema"]
                },
                {
                  "required": ["secretsPath"]
                },
                {
                  "required": ["eventType"]
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "properties": {
    "certificationRules": { "const": "enforcing" },
    "planId": { "type": "string", "minLength": 1 },
    "planVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "packetId": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "required": ["capabilities"],
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "default": {}
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "default": {}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["checkId", "operation", "assertions"],
        "additionalProperties": false,
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "claimIds": { "$ref": "#/$defs/claimIds" },
          "operation": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "fixture": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "input": {},
          "controls": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deadlineMs": { "type": "integer", "minimum": 1 },
              "cancelAfterEvent": { "type": "string", "minLength": 1 }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/assertion" },
            "default": []
          },
          "steps": {
            "type": "array",
            "items": { "$ref": "#/$defs/step" },
            "default": []
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          }
        }
      }
    }
  }
}
