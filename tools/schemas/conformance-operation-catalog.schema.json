{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schemas/conformance-operation-catalog.schema.json",
  "description": "Per-port operation catalog (ADR-0075), one file per port at spec/conformance/<port>/operations.json. Uniqueness of operationId and seamId is checked by the catalog validator because JSON Schema cannot compare keys across array items; the same validator enforces the certification observation dialect on every observation schema: each reachable subschema is false, a $ref to a local #/$defs entry or an encoding definition (bytes, safeInteger, hash, identifier, handle, record, map), an anyOf or oneOf of dialect branches, a const or enum, or an explicitly typed schema whose object types set additionalProperties or unevaluatedProperties to false and whose array types carry a direct items schema. allOf, not, if/then/else, dependentSchemas, $dynamicRef, embedded $id, true, and other type-less schemas are rejected.",
  "type": "object",
  "required": ["catalogId", "catalogVersion", "packetId", "operations"],
  "additionalProperties": false,
  "$defs": {
    "dottedId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$"
    },
    "jsonSchema": { "$ref": "https://json-schema.org/draft/2020-12/schema" },
    "closedObservationSchema": {
      "allOf": [
        { "$ref": "#/$defs/jsonSchema" },
        { "type": "object" },
        {
          "if": {
            "anyOf": [
              { "required": ["properties"] },
              {
                "required": ["type"],
                "properties": { "type": { "const": "object" } }
              }
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": ["additionalProperties"],
                "properties": { "additionalProperties": { "const": false } }
              },
              {
                "required": ["unevaluatedProperties"],
                "properties": { "unevaluatedProperties": { "const": false } }
              }
            ]
          }
        }
      ]
    },
    "handleType": {
      "type": "string",
      "enum": ["instance", "operation", "subscription"]
    },
    "handleTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/handleType" },
      "uniqueItems": true
    },
    "operation": {
      "type": "object",
      "required": ["operationId", "kind", "capability", "input", "observation"],
      "additionalProperties": false,
      "properties": {
        "operationId": { "$ref": "#/$defs/dottedId" },
        "kind": { "type": "string", "enum": ["syscall", "control", "double"] },
        "binding": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/jsonSchema" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "result": { "$ref": "#/$defs/closedObservationSchema" },
            "events": { "$ref": "#/$defs/closedObservationSchema" },
            "state": { "$ref": "#/$defs/closedObservationSchema" }
          }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "handles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "creates": { "$ref": "#/$defs/handleTypes" },
            "consumes": { "$ref": "#/$defs/handleTypes" }
          }
        },
        "faultOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "unsupportedCode"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "unsupportedCode": { "type": "string", "minLength": 1 }
          }
        },
        "deprecated": { "type": "boolean" }
      },
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "syscall" } }
      },
      "then": { "required": ["binding"] }
    },
    "seam": {
      "type": "object",
      "required": ["seamId", "operationIds"],
      "additionalProperties": false,
      "properties": {
        "seamId": { "type": "string", "minLength": 1 },
        "operationIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dottedId" },
          "uniqueItems": true
        }
      }
    }
  },
  "properties": {
    "catalogId": { "type": "string", "minLength": 1 },
    "catalogVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "packetId": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "seams": {
      "type": "array",
      "items": { "$ref": "#/$defs/seam" },
      "default": []
    }
  }
}
