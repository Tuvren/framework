{
  "name": "framework-typescript-conformance-adapter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "typescript/conformance-adapter",
  "projectType": "library",
  "tags": [
    "boundary:framework",
    "language:typescript",
    "layer:conformance-adapter"
  ],
  "targets": {
    "build-batteries-included": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/**",
        "{projectRoot}/tsup.config.batteries-included.ts",
        "{workspaceRoot}/typescript/kernel/backends/sqlite/migrations/**",
        "{workspaceRoot}/typescript/kernel/backends/postgres/migrations/**",
        {
          "externalDependencies": ["tsup"]
        }
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "typescript/conformance-adapter",
        "command": "bunx --bun tsup --config tsup.config.batteries-included.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/biome.jsonc",
        "{workspaceRoot}/oxlint.config.ts",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tools/scripts/json-check.ts",
        "{workspaceRoot}/tools/scripts/json-source-check.ts",
        "{workspaceRoot}/tools/scripts/lib/biome-inventory.ts",
        "{workspaceRoot}/tools/scripts/lib/command-runner.ts",
        "{workspaceRoot}/tools/scripts/lib/json-source-integrity.ts",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ],
      "options": {
        "cwd": ".",
        "commands": [
          "bunx --bun oxlint --type-aware typescript/conformance-adapter",
          "bun tools/scripts/json-check.ts typescript/conformance-adapter"
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["kernel-interop-grpc"],
          "target": "codegen",
          "params": "ignore"
        }
      ],
      "options": {
        "cwd": ".",
        "command": "bun test typescript/conformance-adapter/test/host-protocol.test.ts",
        "forwardAllArgs": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["kernel-interop-grpc"],
          "target": "codegen",
          "params": "ignore"
        }
      ],
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/typecheck-project.ts typescript/conformance-adapter"
      }
    }
  }
}
