{
  "name": "kernel-typescript-conformance-adapter",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "typescript/kernel/conformance-adapter",
  "sourceRoot": "typescript/kernel/conformance-adapter/src",
  "projectType": "library",
  "tags": [
    "boundary:kernel",
    "language:typescript",
    "layer:conformance-adapter"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "typescript/kernel/conformance-adapter",
        "command": "bunx --bun tsup --config tsup.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/biome.jsonc",
        "{workspaceRoot}/oxlint.config.ts",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tools/scripts/json-check.ts",
        "{workspaceRoot}/tools/scripts/json-source-check.ts",
        "{workspaceRoot}/tools/scripts/lib/biome-inventory.ts",
        "{workspaceRoot}/tools/scripts/lib/command-runner.ts",
        "{workspaceRoot}/tools/scripts/lib/json-source-integrity.ts",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ],
      "options": {
        "cwd": ".",
        "commands": [
          "bunx --bun oxlint --type-aware typescript/kernel/conformance-adapter",
          "bun tools/scripts/json-check.ts typescript/kernel/conformance-adapter"
        ],
        "forwardAllArgs": false,
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/typecheck-project.ts typescript/kernel/conformance-adapter"
      }
    }
  }
}
