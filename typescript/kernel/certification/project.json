{
  "name": "kernel-typescript-certification",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "typescript/kernel/certification",
  "projectType": "library",
  "tags": ["boundary:kernel", "language:typescript", "layer:certification"],
  "targets": {
    "conformance": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "conformanceEngine",
        "{workspaceRoot}/spec/conformance/kernel/**/*",
        "{workspaceRoot}/typescript/kernel/conformance-adapter/**/*"
      ],
      "dependsOn": [
        {
          "projects": [
            "backend-memory",
            "kernel-runtime",
            "kernel-typescript-conformance-adapter"
          ],
          "target": "build",
          "params": "ignore"
        }
      ],
      "options": {
        "cwd": ".",
        "command": "bun tools/conformance/harness/run.ts --adapter typescript/kernel/conformance-adapter/adapter.json --concurrency 4 --summary-only"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/biome.jsonc",
        "{workspaceRoot}/oxlint.config.ts",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tools/scripts/json-check.ts",
        "{workspaceRoot}/tools/scripts/json-source-check.ts",
        "{workspaceRoot}/tools/scripts/lib/biome-inventory.ts",
        "{workspaceRoot}/tools/scripts/lib/command-runner.ts",
        "{workspaceRoot}/tools/scripts/lib/json-source-integrity.ts",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "^production",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tools/conformance/adapter-protocol/**/*",
        "{workspaceRoot}/typescript/kernel/conformance-adapter/src/**/*",
        "{workspaceRoot}/typescript/runtime/src/**/*",
        "{workspaceRoot}/typescript/sdk/src/**/*",
        "{workspaceRoot}/typescript/telemetry/semconv/src/**/*"
      ],
      "options": {
        "cwd": ".",
        "commands": [
          "bunx --bun oxlint --type-aware typescript/kernel/certification",
          "bun tools/scripts/json-check.ts typescript/kernel/certification"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "typescript/kernel/certification",
        "command": "bun test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/typecheck-project.ts typescript/kernel/certification"
      }
    }
  }
}
