{
  "name": "backend-postgres",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "root": "typescript/kernel/backends/postgres",
  "sourceRoot": "typescript/kernel/backends/postgres/src",
  "projectType": "library",
  "tags": ["boundary:kernel", "layer:implementation"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "typescript/kernel/backends/postgres",
        "command": "bunx --bun tsup --config tsup.config.ts && bun ../../../../tools/scripts/compile-with-migrations.ts --tsconfig tsconfig.dts.json --out dist"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "typescript/kernel/backends/postgres",
        "command": "bun bench/postgres-write-latency.bench.ts"
      }
    },
    "bench-cross-scope-throughput": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "typescript/kernel/backends/postgres",
        "command": "bun bench/postgres-cross-scope-throughput.bench.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "commands": [
          "bunx --bun oxlint --type-aware typescript/kernel/backends/postgres",
          "bun tools/scripts/json-check.ts typescript/kernel/backends/postgres"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "typescript/kernel/backends/postgres",
        "command": "bun test ./test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/typecheck-project.ts typescript/kernel/backends/postgres"
      }
    }
  }
}
