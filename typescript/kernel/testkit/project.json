{
  "name": "kernel-testkit",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "typescript/kernel/testkit",
  "sourceRoot": "typescript/kernel/testkit/src",
  "projectType": "library",
  "tags": ["boundary:kernel", "layer:testkit"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "typescript/kernel/testkit",
        "command": "bunx --bun tsup --config tsup.config.ts && bunx --bun tsc --project tsconfig.dts.json --pretty false"
      }
    },
    "conformance": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/spec/conformance/kernel/**/*"
      ],
      "options": {
        "cwd": "typescript/kernel/testkit",
        "command": "bun test ./test/kernel-conformance.test.ts"
      }
    },
    "exports-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "typescript/kernel/testkit",
        "command": "bun test ./smoke/package-exports.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/biome.jsonc",
        "{workspaceRoot}/oxlint.config.ts",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tools/scripts/json-check.ts",
        "{workspaceRoot}/tools/scripts/json-source-check.ts",
        "{workspaceRoot}/tools/scripts/lib/biome-inventory.ts",
        "{workspaceRoot}/tools/scripts/lib/command-runner.ts",
        "{workspaceRoot}/tools/scripts/lib/json-source-integrity.ts",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "^production",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "cwd": ".",
        "commands": [
          "bunx --bun oxlint --type-aware typescript/kernel/testkit",
          "bun tools/scripts/json-check.ts typescript/kernel/testkit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/spec/conformance/kernel/**/*",
        "{workspaceRoot}/spec/kernel/**/*",
        "{workspaceRoot}/tools/schemas/negative-control-manifest.schema.json",
        "{workspaceRoot}/docs/KrakenKernelSpecification.md",
        "{workspaceRoot}/.constitution/tech-spec/adrs/**/*",
        "{workspaceRoot}/typescript/**/package.json",
        "{workspaceRoot}/typescript/**/src/**/*"
      ],
      "options": {
        "cwd": "typescript/kernel/testkit",
        "command": "bun test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/typecheck-project.ts typescript/kernel/testkit"
      }
    }
  }
}
