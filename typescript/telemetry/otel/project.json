{
  "name": "framework-telemetry-otel",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "root": "typescript/telemetry/otel",
  "sourceRoot": "typescript/telemetry/otel/src",
  "projectType": "library",
  "tags": ["boundary:framework", "layer:implementation"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "typescript/telemetry/otel",
        "command": "bunx --bun tsup --config tsup.config.ts && bunx --bun tsc --project tsconfig.dts.json --pretty false"
      }
    },
    "exports-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "typescript/telemetry/otel",
        "command": "bun test ./smoke/package-exports.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "commands": [
          "bunx --bun oxlint --type-aware typescript/telemetry/otel",
          "bun tools/scripts/json-check.ts typescript/telemetry/otel"
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "inputs": [
        "default",
        "{workspaceRoot}/biome.jsonc",
        "{workspaceRoot}/oxlint.config.ts",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tools/scripts/json-check.ts",
        "{workspaceRoot}/tools/scripts/json-source-check.ts",
        "{workspaceRoot}/tools/scripts/lib/biome-inventory.ts",
        "{workspaceRoot}/tools/scripts/lib/command-runner.ts",
        "{workspaceRoot}/tools/scripts/lib/json-source-integrity.ts",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "^production"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "typescript/telemetry/otel",
        "command": "bun test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/typecheck-project.ts typescript/telemetry/otel"
      }
    }
  }
}
