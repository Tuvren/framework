{
  "controls": [
    {
      "mutantId": "kernel.accept-noncanonical-cbor",
      "kind": "implementation",
      "rule": "docs/KrakenKernelSpecification.md#23-hash",
      "claimIds": ["kernel.protocol.canonical_rejection"],
      "activation": {
        "precondition": "the deterministic decoder rejects a top-level unsigned integer whose one-byte argument head carries a value below 24",
        "signal": "mutant.accept-noncanonical-cbor.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.protocol.canonical_rejection.1.resultField"
      ]
    },
    {
      "mutantId": "kernel.accept-stale-head-update",
      "kind": "implementation",
      "rule": "docs/KrakenKernelSpecification.md#branch-head-movement",
      "claimIds": ["kernel.crash-recovery.concurrent_writer"],
      "activation": {
        "precondition": "a backend transaction sets a branch head from a stale read and the reference backend rejects it as a lateral move",
        "signal": "mutant.accept-stale-head-update.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.crash-recovery.concurrent_writer.1.resultField",
        "kernel.crash-recovery.concurrent_writer.3.resultField",
        "kernel.crash-recovery.concurrent_writer.4.resultField"
      ]
    },
    {
      "mutantId": "kernel.accept-stale-owner-after-takeover",
      "kind": "implementation",
      "rule": "docs/KrakenKernelSpecification.md#run-execution-leases",
      "claimIds": ["kernel.syscall.run-liveness.lease_renewal"],
      "activation": {
        "precondition": "a lease renewal presents a superseded owner or fencing token and the reference kernel rejects it",
        "signal": "mutant.accept-stale-owner-after-takeover.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.syscall.run-liveness.lease_renewal.3.schemaValid",
        "kernel.syscall.run-liveness.lease_renewal.4.schemaValid"
      ]
    },
    {
      "mutantId": "kernel.delete-object-reachable-through-live-root",
      "kind": "implementation",
      "rule": "docs/KrakenKernelSpecification.md#94-maintenancereclamation-capability-v012",
      "claimIds": [
        "kernel.syscall.reclamation.reachable_from_live_root_is_retained",
        "kernel.syscall.reclamation.shared_object_retained_via_live_root"
      ],
      "activation": {
        "precondition": "reclamation releases an archived branch whose fork point consumed an object that a live branch head still reaches",
        "signal": "mutant.delete-object-reachable-through-live-root.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.syscall.reclamation.reachability.8.resultField"
      ]
    },
    {
      "mutantId": "kernel.drop-uncommitted-staged-result-on-recovery",
      "kind": "implementation",
      "rule": "docs/KrakenKernelSpecification.md#57-recovery-protocol",
      "claimIds": [
        "kernel.syscall.logical.recovery_state",
        "kernel.crash-recovery.in_process_fault_points",
        "kernel.syscall.crash-recovery.before_commit"
      ],
      "activation": {
        "precondition": "run.recover returns at least one uncommitted staged result",
        "signal": "mutant.drop-uncommitted-staged-result-on-recovery.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.syscall.logical.recovery_state.3.resultField",
        "kernel.crash-recovery.in_process_fault_points.5.resultField",
        "kernel.syscall.crash-recovery.before_commit.6.resultField",
        "kernel.syscall.crash-recovery.before_commit.12.resultField"
      ]
    },
    {
      "mutantId": "kernel.fault-seam-never-fires",
      "kind": "instrumentation",
      "rule": "ADR-0076",
      "claimIds": [
        "kernel.crash-recovery.in_process_fault_points",
        "kernel.crash-recovery.concurrent_writer",
        "kernel.syscall.controls.before_commit",
        "kernel.syscall.controls.after_commit_before_ack",
        "kernel.syscall.crash-recovery.before_commit",
        "kernel.syscall.crash-recovery.after_commit_before_ack"
      ],
      "activation": {
        "precondition": "a fault plan is armed on the in-process fault-injecting backend",
        "signal": "mutant.fault-seam-never-fires.entered"
      },
      "profiles": ["kernel.memory"],
      "expectedRejection": "missing_fault_activation"
    },
    {
      "mutantId": "kernel.lease-takeover-before-expiry",
      "kind": "implementation",
      "rule": "docs/KrakenKernelSpecification.md#stale-running-preemption",
      "claimIds": [
        "kernel.syscall.run-liveness.live_lease_excluded_from_expiry"
      ],
      "activation": {
        "precondition": "an expiry listing or preemption targets a running run whose lease has not expired at the caller's clock",
        "signal": "mutant.lease-takeover-before-expiry.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.syscall.run-liveness.expired_listing.2.resultField",
        "kernel.syscall.run-liveness.lease_renewal.8.resultField"
      ]
    },
    {
      "mutantId": "kernel.never-sweep-eligible-objects",
