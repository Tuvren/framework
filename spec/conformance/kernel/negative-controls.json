      "activation": {
        "precondition": "maintenance.reclaim is invoked on a reclamation-capable backend",
        "signal": "mutant.never-sweep-eligible-objects.entered"
      },
      "profiles": ["kernel.memory"],
      "designatedAssertions": [
        "kernel.syscall.reclamation.reachability.1.resultField",
        "kernel.syscall.reclamation.reachability.2.resultField",
        "kernel.syscall.reclamation.reachability.4.resultField",
        "kernel.syscall.reclamation.grace_window_holds_under_active_lease.1.resultField",
        "kernel.syscall.reclamation.leaseless_run_past_admin_expiry_does_not_pin_reclamation.1.resultField"
      ]
    },
    {
