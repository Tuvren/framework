{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schemas/reports/compatibility/compatibility-matrix.schema.json",
  "type": "object",
  "required": [
    "generatedAtMs",
    "sourceRevision",
    "suites",
    "implementations",
    "interop",
    "certificates"
  ],
  "properties": {
    "generatedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suiteId", "suiteVersion", "boundary"],
        "properties": {
          "suiteId": {
            "type": "string"
          },
          "suiteVersion": {
            "type": "string"
          },
          "boundary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["implementationId", "language", "version", "results"],
        "properties": {
          "implementationId": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "suiteId",
                "suiteVersion",
                "status",
                "reportStatus",
                "reportLabel",
                "evidencePath",
                "checkIds",
                "checkSummary"
              ],
              "properties": {
                "suiteId": {
                  "type": "string"
                },
                "suiteVersion": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": ["fail", "not_applicable", "pass", "unsupported"]
                },
                "reportStatus": {
                  "type": "string",
                  "enum": [
                    "full_pass",
                    "capability_subset_pass",
                    "unsupported",
                    "not_applicable",
                    "expected_fail",
                    "unexpected_fail"
                  ]
                },
                "reportLabel": {
                  "type": "string"
                },
                "declaredCapabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidencePath": {
                  "type": "string"
                },
                "checkIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "checkSummary": {
                  "type": "object",
                  "required": ["failedChecks", "passedChecks", "totalChecks"],
                  "properties": {
                    "applicableChecks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "failedChecks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "nonApplicableChecks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "passedChecks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "totalChecks": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unsupportedChecks": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "interop": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pairId",
          "suiteId",
          "suiteVersion",
          "status",
          "reportStatus",
          "reportLabel",
          "evidencePath",
          "checkIds",
          "checkSummary"
        ],
        "properties": {
          "pairId": {
            "type": "string"
          },
          "suiteId": {
            "type": "string"
          },
          "suiteVersion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["fail", "not_applicable", "pass", "unsupported"]
          },
          "reportStatus": {
            "type": "string",
            "enum": [
              "full_pass",
              "capability_subset_pass",
              "unsupported",
              "not_applicable",
              "expected_fail",
              "unexpected_fail"
            ]
          },
          "reportLabel": {
            "type": "string"
          },
          "evidencePath": {
            "type": "string"
          },
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checkSummary": {
            "type": "object",
            "required": ["failedChecks", "passedChecks", "totalChecks"],
            "properties": {
              "applicableChecks": {
                "type": "integer",
                "minimum": 0
              },
              "failedChecks": {
                "type": "integer",
                "minimum": 0
              },
              "nonApplicableChecks": {
                "type": "integer",
                "minimum": 0
              },
              "passedChecks": {
                "type": "integer",
                "minimum": 0
              },
              "totalChecks": {
                "type": "integer",
                "minimum": 1
              },
              "unsupportedChecks": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "implementationId",
          "backend",
          "profile",
          "status",
          "digests"
        ],
        "properties": {
          "implementationId": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "enum": ["memory", "sqlite", "postgres"]
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "certified"
          },
          "digests": {
            "type": "object",
            "required": [
              "adapterManifest",
              "packet",
              "plans",
              "catalogs",
              "fixtures",
              "profiles",
              "controls",
              "verifierAuthority"
            ],
            "properties": {
              "adapterManifest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "packet": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "plans": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "catalogs": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "fixtures": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "profiles": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "controls": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "verifierAuthority": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
