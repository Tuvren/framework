{
  "name": "compatibility-reporting",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "reports/compatibility",
  "projectType": "library",
  "tags": ["boundary:reports", "layer:tooling"],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "//": "Cross-boundary aggregator: intentionally broad inputs (every boundary's conformance evidence + adapter manifests). This target stays wide on purpose while per-boundary conformance runners are tightly scoped.",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/scripts/**/*",
        "{workspaceRoot}/tools/conformance/**/*",
        "{workspaceRoot}/spec/conformance/**/*",
        "{workspaceRoot}/typescript/conformance-adapter/**/*",
        "{workspaceRoot}/typescript/kernel/conformance-adapter/**/*",
        "{workspaceRoot}/typescript/providers/conformance-adapter/**/*",
        "{workspaceRoot}/rust/conformance-adapter/**/*",
        "{workspaceRoot}/rust/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/go/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/python/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/dart/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/spec/**/*",
        "{workspaceRoot}/tools/schemas/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/.gitignore",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/compatibility-report.ts --check"
      },
      "dependsOn": [
        {
          "target": "codegen",
          "projects": [
            "core-spec",
            "host-spec",
            "streaming-spec",
            "runners-spec",
            "tools-spec",
            "providers-spec",
            "telemetry-spec",
            "kernel-interop-grpc"
          ]
        }
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/scripts/**/*",
        "{workspaceRoot}/tools/conformance/**/*",
        "{workspaceRoot}/spec/conformance/**/*",
        "{workspaceRoot}/typescript/conformance-adapter/**/*",
        "{workspaceRoot}/typescript/kernel/conformance-adapter/**/*",
        "{workspaceRoot}/typescript/providers/conformance-adapter/**/*",
        "{workspaceRoot}/rust/conformance-adapter/**/*",
        "{workspaceRoot}/rust/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/go/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/python/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/dart/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/spec/**/*",
        "{workspaceRoot}/tools/schemas/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/oxfmt.config.ts",
        "{workspaceRoot}/.gitignore",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/compatibility-report.ts --check"
      }
    },
    "evidence-refresh": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/scripts/**/*",
        "{workspaceRoot}/tools/conformance/**/*",
        "{workspaceRoot}/spec/conformance/**/*",
        "{workspaceRoot}/typescript/conformance-adapter/**/*",
        "{workspaceRoot}/typescript/kernel/conformance-adapter/**/*",
        "{workspaceRoot}/typescript/providers/conformance-adapter/**/*",
        "{workspaceRoot}/rust/conformance-adapter/**/*",
        "{workspaceRoot}/rust/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/go/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/python/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/dart/kernel-conformance-adapter/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/oxfmt.config.ts"
      ],
      "outputs": [
        "{workspaceRoot}/reports/compatibility/compatibility-matrix.json",
        "{workspaceRoot}/reports/compatibility/evidence"
      ],
      "options": {
        "cwd": ".",
        "command": "bun tools/scripts/compatibility-report.ts --allow-failing-evidence"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bunx --bun @biomejs/biome check reports/compatibility tools/scripts/compatibility-report.ts tools/scripts/telemetry-codegen.ts tools/scripts/lib"
      }
    }
  }
}
