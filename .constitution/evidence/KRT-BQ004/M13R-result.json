    "patterns": [
      {
        "pattern": "Typed empty dictionary allocation followed by Object.setPrototypeOf(dictionary, null)",
        "purpose": "Retain null-prototype normalization without unsafe Object.create return assertions."
      },
      {
        "pattern": "Private bounded async recursion for sequential benchmark iterations/samples/cases",
        "purpose": "Preserve strict sequential execution under no-await-in-loop. Benchmark timing includes helper overhead and is smoke evidence, not a performance comparison."
      },
      {
        "pattern": "Test-only rejectionOf(Promise<unknown>) returning the caught Error",
        "purpose": "Await rejection before assertions with Bun matcher declarations that return void."
      },
      {
        "pattern": "Test-only Reflect.apply invocation capturing unknown and checking Promise",
        "purpose": "Exercise malformed inputs without pretending they satisfy public types; this extends the existing tree-input probe to node inputs."
      },
      {
        "pattern": "Object.fromEntries<KernelRecord> for intentionally reversed fixture key order",
        "purpose": "Keep exact key insertion differences under sort-keys."
